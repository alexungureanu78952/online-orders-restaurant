<Window x:Class="RestaurantOrderManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant Order Management"
        Height="780"
        Width="1200"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Restaurant Order Management"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="{Binding CurrentRole, StringFormat=Access: {0}}"
                               FontSize="12"
                               Foreground="#ECF0F1"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanShowLogin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox Width="220"
                             Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Email"
                             Margin="0,0,8,0"
                             Padding="10,7"/>
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Width="180"
                                 ToolTip="Password"
                                 Margin="0,0,8,0"
                                 Padding="10,7"
                                 PasswordChanged="OnPasswordChanged"/>
                    <Button Content="Sign In"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Background="#27AE60"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="14,7"/>
                    <TextBlock Text="{Binding LoginErrorMessage}"
                               Foreground="#FADBD8"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Visibility="{Binding LoginErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentUserDisplay, StringFormat=Signed in: {0}}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Sign Out"
                            Command="{Binding LogoutCommand}"
                            Background="#95A5A6"
                            Foreground="White"
                            Padding="12,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sections"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Margin="16,16,16,8"/>
                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="White"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,7">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="#7F8C8D"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding SelectedNavigationItem.ViewModel}"
                            Margin="0"/>
        </Grid>
    </Grid>
</Window>
