<Window x:Class="RestaurantOrderManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant Order Management"
        Height="780"
        Width="1200"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BkHeaderButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight"
                    Value="44"/>
            <Setter Property="MinWidth"
                    Value="92"/>
            <Setter Property="Padding"
                    Value="18,10"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontWeight"
                    Value="Black"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BkNavItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Margin"
                    Value="10,4"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="18"
                                Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#FFE6C7"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#D62300"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF3DF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D62300"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="64"
                            Height="64"
                            Background="#FFAA00"
                            CornerRadius="32"
                            Margin="0,0,16,0">
                        <TextBlock Text="ROM"
                                   Foreground="#502314"
                                   FontSize="18"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Restaurant Order Management"
                                   FontSize="26"
                                   FontWeight="Black"
                                   Foreground="#FFF3DF"/>
                        <TextBlock Text="{Binding CurrentRole, StringFormat=Access: {0}}"
                                   FontSize="12"
                                   Foreground="#FFE6C7"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanShowLogin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Email"
                                   Foreground="#FFE6C7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="2,0,0,3"/>
                        <TextBox Width="240"
                                 Height="38"
                                 Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Email"
                                 Padding="12,8"
                                 Background="#FFF3DF"
                                 BorderBrush="#FFAA00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Password"
                                   Foreground="#FFE6C7"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="2,0,0,3"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     Width="200"
                                     Height="38"
                                     ToolTip="Password"
                                     Padding="12,8"
                                     Background="#FFF3DF"
                                     BorderBrush="#FFAA00"
                                     PasswordChanged="OnPasswordChanged"/>
                    </StackPanel>
                    <Button Content="Sign In"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Style="{StaticResource BkHeaderButtonStyle}"
                            Background="#502314"
                            Foreground="#FFF3DF"
                            VerticalAlignment="Bottom"/>
                    <Button Content="Guest"
                            Command="{Binding ContinueAsGuestCommand}"
                            Style="{StaticResource BkHeaderButtonStyle}"
                            Background="#FFAA00"
                            Foreground="#502314"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding LoginErrorMessage}"
                               Foreground="#FFF3DF"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               Visibility="{Binding LoginErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentUserDisplay, StringFormat=Signed in: {0}}"
                               Foreground="#FFF3DF"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Sign Out"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource BkHeaderButtonStyle}"
                            Background="#FFAA00"
                            Foreground="#502314"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFF3DF"
                    BorderBrush="#F1C27D"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Order your way"
                               FontSize="20"
                               FontWeight="Black"
                               Foreground="#502314"
                               Margin="20,20,16,6"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Menu, ordering, tracking and restaurant tools."
                               FontSize="12"
                               Foreground="#8A4B2A"
                               TextWrapping="Wrap"
                               Margin="20,0,18,14"/>
                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="#FFF3DF"
                             ItemContainerStyle="{StaticResource BkNavItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="Black"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Opacity="0.78"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding SelectedNavigationItem.ViewModel}"
                            Margin="18"/>
        </Grid>
    </Grid>
</Window>
