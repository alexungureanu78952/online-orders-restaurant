<UserControl x:Class="RestaurantOrderManagement.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
        d:DesignWidth="1200"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                Background="#2C3E50">
            <TextBlock Text="Inventory Management"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"/>
            <TextBlock Text="View and manage product stock levels"
                    FontSize="14"
                    Foreground="#ECF0F1"
                    Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filters and Actions -->
        <Grid Grid.Row="1"
                Background="White"
                Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Info Text -->
            <TextBlock Text="Low Stock Threshold:"
                    FontSize="12"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Grid.Column="0"
                    Margin="0,0,10,0"/>
            <TextBlock Text="{Binding LowStockThreshold, StringFormat='{}{0}g'}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Grid.Column="1"
                    Foreground="#E67E22"
                    FontWeight="Bold"/>

            <!-- Refresh Button -->
            <Button Content="Refresh"
                    Background="#3498DB"
                    Foreground="White"
                    Padding="15,6"
                    HorizontalAlignment="Right"
                    Grid.Column="3"
                    Command="{Binding LoadLowStockProductsCommand}"/>
        </Grid>

        <!-- Inventory Management Layout -->
        <Grid Grid.Row="2"
                Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Low Stock Products List -->
            <ListBox Grid.Column="0"
                    ItemsSource="{Binding LowStockProducts}"
                    SelectedItem="{Binding SelectedProduct}"
                     Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="4">
                            <StackPanel>
                                <!-- Product Name -->
                                <TextBlock Text="{Binding Name}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#2C3E50"/>

                                <!-- Current Quantity -->
                                <TextBlock Text="{Binding TotalQuantity, StringFormat='Current: {0}g'}"
                                        FontSize="11"
                                        Foreground="#7F8C8D"
                                        Margin="0,5,0,5"/>

                                <!-- Status -->
                                <Border Background="#ECF0F1"
                                        Padding="5,3"
                                        CornerRadius="3"
                                        Width="Auto"
                                        HorizontalAlignment="Left">
                                    <TextBlock FontSize="10"
                                            Foreground="#2C3E50"
                                            FontWeight="Bold"
                                            Text="{Binding Category.Name}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Product Details and Restock Panel -->
            <ScrollViewer Grid.Column="1"
                    VerticalScrollBarVisibility="Auto"
                    Background="White">
                <StackPanel
                        Visibility="{Binding SelectedProduct, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <!-- Success Message -->
                    <Border Background="#D4EDDA"
                            BorderBrush="#28A745"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,15"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                FontSize="12"
                                Foreground="#155724"
                                TextWrapping="Wrap"/>
                    </Border>

                    <!-- Error Message -->
                    <Border Background="#F8D7DA"
                            BorderBrush="#DC3545"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,15"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                FontSize="12"
                                Foreground="#721C24"
                                TextWrapping="Wrap"/>
                    </Border>

                    <!-- Product Header -->
                    <TextBlock Text="{Binding SelectedProduct.Name, StringFormat='Product: {0}'}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Margin="0,0,0,15"/>

                    <!-- Stock Status Section -->
                    <Border Background="#FFF8E1"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Stock Status"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#2C3E50"
                                    Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Category -->
                                <TextBlock Text="Category:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="0"
                                        Grid.Column="0"/>
                                <TextBlock Text="{Binding SelectedProduct.Category.Name}"
                                        FontSize="11"
                                        Foreground="#34495E"
                                        Grid.Row="0"
                                        Grid.Column="1"/>

                                <!-- Description -->
                                <TextBlock Text="Description:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding SelectedProduct.Description}"
                                        FontSize="11"
                                        Foreground="#34495E"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        TextWrapping="Wrap"/>

                                <!-- Unit Price -->
                                <TextBlock Text="Unit Price:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedProduct.Price, StringFormat='{}{0:F2} lei'}"
                                        FontSize="11"
                                        Foreground="#34495E"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"/>

                                <!-- Portion Size -->
                                <TextBlock Text="Portion Size:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SelectedProduct.PortionQuantity, StringFormat='{}{0}g'}"
                                        FontSize="11"
                                        Foreground="#34495E"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Current Inventory -->
                    <TextBlock Text="Current Inventory"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Margin="0,0,0,10"/>
                    <Border Background="#ECF0F1"
                            Padding="12"
                            CornerRadius="4"
                            Margin="0,0,0,15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Quantity -->
                                <TextBlock Text="Current Quantity:"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Column="0"/>
                                <TextBlock Text="{Binding SelectedProduct.TotalQuantity, StringFormat='{}{0}g'}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#2C3E50"
                                        Grid.Column="1"
                                        TextAlignment="Right"/>
                            </Grid>

                            <!-- Stock Status -->
                            <TextBlock Margin="0,10,0,0"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#7F8C8D">
                                <Run Text="Status: "/>
                                <Run Text="{Binding SelectedProduct.TotalQuantity}"/>
                            </TextBlock>

                            <!-- Progress Bar -->
                            <ProgressBar Height="20"
                                    Margin="0,8,0,0"
                                    Foreground="#E67E22"
                                    Background="#ECF0F1"
                                         Minimum="0"
                                    Maximum="{Binding LowStockThreshold}"
                                         Value="{Binding SelectedProduct.TotalQuantity}"/>
                        </StackPanel>
                    </Border>

                    <!-- Restock Section -->
                    <Border Background="#E8F5E9"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Restock Product"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#2C3E50"
                                    Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Restock Quantity Label -->
                                <TextBlock Text="Restock Qty:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"/>

                                <!-- Restock Quantity Input -->
                                <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,0">
                                    <TextBox Text="{Binding RestockQuantity}"
                                            Width="80"
                                            Padding="8,6"
                                            FontSize="11"
                                            BorderBrush="#BDBDBD"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="grams"
                                            FontSize="11"
                                            Foreground="#7F8C8D"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Quick Buttons -->
                                <TextBlock Text="Quick Add:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,10,0,0"/>
                                <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                    <Button Content="250g"
                                            Background="#E0E0E0"
                                            Padding="8,4"
                                            Margin="0,0,5,0"
                                            FontSize="10"
                                            Command="{Binding SetRestockQuantityCommand}"
                                            CommandParameter="250"/>
                                    <Button Content="500g"
                                            Background="#E0E0E0"
                                            Padding="8,4"
                                            Margin="0,0,5,0"
                                            FontSize="10"
                                            Command="{Binding SetRestockQuantityCommand}"
                                            CommandParameter="500"/>
                                    <Button Content="1000g"
                                            Background="#E0E0E0"
                                            Padding="8,4"
                                            Margin="0,0,5,0"
                                            FontSize="10"
                                            Command="{Binding SetRestockQuantityCommand}"
                                            CommandParameter="1000"/>
                                    <Button Content="2000g"
                                            Background="#E0E0E0"
                                            Padding="8,4"
                                            FontSize="10"
                                            Command="{Binding SetRestockQuantityCommand}"
                                            CommandParameter="2000"/>
                                </StackPanel>

                                <!-- New Quantity Preview -->
                                <TextBlock Text="New Qty:"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#7F8C8D"
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding ProjectedRestockQuantity, StringFormat='{}{0}g'}"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#27AE60"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"/>
                            </Grid>

                            <!-- Restock Button -->
                            <Button Content="Confirm Restock"
                                    Background="#27AE60"
                                    Foreground="White"
                                    Padding="15,12"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RestockProductCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading Indicator -->
        <TextBlock Grid.Row="2"
                Text="Loading inventory..."
                FontSize="14"
                Foreground="#3498DB"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Empty State -->
        <TextBlock Grid.Row="2"
                Text="No low-stock products found. All items are well stocked!"
                FontSize="14"
                Foreground="#27AE60"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                   Visibility="{Binding LowStockProducts.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"/>
    </Grid>
</UserControl>
