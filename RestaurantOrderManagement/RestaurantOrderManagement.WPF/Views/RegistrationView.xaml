<UserControl x:Class="RestaurantOrderManagement.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="750"
        d:DesignWidth="500"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                Background="#2C3E50"
                Padding="20">
            <TextBlock Text="Create Account"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"/>
            <TextBlock Text="Join us and start ordering"
                    FontSize="14"
                    Foreground="#ECF0F1"
                    Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Registration Form -->
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="30"
                    Background="White"
                    Margin="10,10,10,0">

                <!-- Success Message -->
                <Border Background="#D4EDDA"
                        BorderBrush="#28A745"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,15"
                        Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#155724"
                               FontSize="12"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Error Message -->
                <Border Background="#F8D7DA"
                        BorderBrush="#F5C6CB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,15"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#721C24"
                               FontSize="12"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Email -->
                <TextBlock Text="Email Address *"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,5"
                        Foreground="#2C3E50"/>
                <TextBox x:Name="EmailBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,10"
                         FontSize="11"
                         Margin="0,0,0,15"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ToolTip="Enter your email address"/>

                <!-- First Name -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">
                        <TextBlock Text="First Name *"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="0,0,0,5"
                                Foreground="#2C3E50"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,10"
                                 FontSize="11"
                                 Background="White"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">
                        <TextBlock Text="Last Name *"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="0,0,0,5"
                                Foreground="#2C3E50"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,10"
                                 FontSize="11"
                                 Background="White"
                                 BorderBrush="#BDC3C7"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Password -->
                <TextBlock Text="Password *"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,5"
                        Foreground="#2C3E50"/>
                <TextBox x:Name="PasswordBox"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,10"
                         FontSize="11"
                         Margin="0,0,0,15"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ToolTip="At least 6 characters"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password *"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,5"
                        Foreground="#2C3E50"/>
                <TextBox x:Name="ConfirmPasswordBox"
                         Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,10"
                         FontSize="11"
                         Margin="0,0,0,15"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ToolTip="Must match password"/>

                <!-- Phone Number -->
                <TextBlock Text="Phone Number (optional)"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,5"
                        Foreground="#2C3E50"/>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,10"
                         FontSize="11"
                         Margin="0,0,0,15"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ToolTip="Enter your phone number"/>

                <!-- Delivery Address -->
                <TextBlock Text="Delivery Address (optional)"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,0,5"
                        Foreground="#2C3E50"/>
                <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,10"
                         FontSize="11"
                         Margin="0,0,0,20"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         TextWrapping="Wrap"
                         Height="60"
                         VerticalAlignment="Top"
                         AcceptsReturn="True"
                         ToolTip="Enter your delivery address"/>

                <!-- Required Fields Note -->
                <TextBlock Text="* Required fields"
                        FontSize="10"
                        Foreground="#95A5A6"
                        Margin="0,0,0,20"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with Buttons -->
        <Grid Grid.Row="2"
                Background="White"
                Padding="30,20"
                Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Clear Button -->
            <Button Grid.Column="0"
                    Command="{Binding ClearFormCommand}"
                    Background="#95A5A6"
                    Foreground="White"
                    Padding="15,12"
                    FontWeight="Bold"
                    FontSize="12"
                    Margin="0,0,10,0"
                    ToolTip="Clear all fields">
                Clear
            </Button>

            <!-- Register Button -->
            <Button Grid.Column="1"
                    Command="{Binding RegisterCommand}"
                    Background="#27AE60"
                    Foreground="White"
                    Padding="15,12"
                    FontWeight="Bold"
                    FontSize="12">
                <TextBlock Text="{Binding IsLoading, StringFormat='{0:Register}'}"
                        Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
