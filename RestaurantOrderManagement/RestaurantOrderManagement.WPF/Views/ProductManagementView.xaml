<UserControl x:Class="RestaurantOrderManagement.WPF.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Background="#2C3E50">
            <TextBlock Text="Product &amp; Category Management"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Create, update, and manage menu items and categories"
                       FontSize="14"
                       Foreground="#ECF0F1"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1"
                    Background="White"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
            <Button Content="➕ New Product"
                    Background="#27AE60"
                    Foreground="White"
                    Padding="15,10"
                    Command="{Binding ShowProductCreateFormCommand}"/>
            <Button Content="➕ New Category"
                    Background="#3498DB"
                    Foreground="White"
                    Padding="15,10"
                    Command="{Binding ShowCategoryCreateFormCommand}"/>
            <Button Content="🔄 Refresh"
                    Background="#34495E"
                    Foreground="White"
                    Padding="15,10"
                    Command="{Binding LoadProductsAndCategoriesCommand}"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2"
              Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Products List -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Products Header -->
                    <TextBlock Grid.Row="0"
                               Text="Products"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Padding="15"/>

                    <!-- Products ListBox -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AllProducts}"
                             SelectedItem="{Binding SelectedProduct}"
                             Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Category.Name}"
                                                   FontSize="10"
                                                   Foreground="#7F8C8D"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Price, StringFormat='${0:F2}'}"
                                                   FontSize="10"
                                                   Foreground="#27AE60"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat='Stock: {0}g'}"
                                                   FontSize="9"
                                                   Foreground="#95A5A6"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Categories List -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Categories Header -->
                    <TextBlock Grid.Row="0"
                               Text="Categories"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Padding="15"/>

                    <!-- Categories ListBox -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AllCategories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="10"
                                                   Foreground="#7F8C8D"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                        <Border Background="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#D4EDDA|#F8D7DA'}"
                                                Padding="5,3"
                                                CornerRadius="3"
                                                Width="Auto"
                                                HorizontalAlignment="Left"
                                                Margin="0,5,0,0">
                                            <TextBlock FontSize="9"
                                                       Foreground="#2C3E50"
                                                       Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Active|Inactive}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Menus List -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Menus"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Padding="15"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AllMenus}"
                             SelectedItem="{Binding SelectedMenu}"
                             Background="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#2C3E50"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category.Name}"
                                                   FontSize="10"
                                                   Foreground="#7F8C8D"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding BundleDiscountPercent, StringFormat='Discount: {0:F0}%'}"
                                                   FontSize="9"
                                                   Foreground="#27AE60"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Detail and Edit Panel -->
            <Border Grid.Column="3"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Success Message -->
                        <Border Background="#D4EDDA"
                                BorderBrush="#28A745"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,15"
                                Visibility="{Binding SuccessMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding SuccessMessage}"
                                       FontSize="12"
                                       Foreground="#155724"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Error Message -->
                        <Border Background="#F8D7DA"
                                BorderBrush="#DC3545"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,15"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="12"
                                       Foreground="#721C24"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Product Form -->
                        <StackPanel Visibility="{Binding ShowProductForm, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Edit Product|Create New Product}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,15"/>

                            <!-- Category Selection -->
                            <TextBlock Text="Category *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AllCategories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Background="White"
                                      BorderBrush="#BDC3C7"
                                      Padding="10"
                                      Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Product Name -->
                            <TextBlock Text="Product Name *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Margin="0,0,0,15"/>

                            <!-- Description -->
                            <TextBlock Text="Description"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>

                            <!-- Product Image URL -->
                            <TextBlock Text="Presentation Image URL"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ProductImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Height="52"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>
                            <Border Height="120"
                                    Background="#FFF3DF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,0,15"
                                    Visibility="{Binding ProductImageUrl, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <Image Source="{Binding ProductImageUrl}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="8"/>
                            </Border>

                            <!-- Price -->
                            <TextBlock Text="Price ($) *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ProductPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Margin="0,0,0,15"/>

                            <!-- Portion Quantity -->
                            <TextBlock Text="Portion Size (g) *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ProductPortionQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Margin="0,0,0,15"/>

                            <!-- Total Quantity -->
                            <TextBlock Text="Total Stock (g)"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"
                                       Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBox Text="{Binding ProductTotalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Margin="0,0,0,15"
                                     Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <!-- Available Checkbox -->
                            <CheckBox Content="Available"
                                      IsChecked="{Binding ProductIsAvailable}"
                                      Margin="0,0,0,15"
                                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,15,0,0">
                                <Button Content="Save"
                                        Background="#27AE60"
                                        Foreground="White"
                                        Padding="15,8"
                                        Command="{Binding SaveProductCommand}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="Cancel"
                                        Background="#95A5A6"
                                        Foreground="White"
                                        Padding="15,8"
                                        Click="CancelProductForm_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Category Form -->
                        <StackPanel Visibility="{Binding ShowCategoryForm, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Edit Category|Create New Category}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,15"/>

                            <!-- Category Name -->
                            <TextBlock Text="Category Name *"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Margin="0,0,0,15"/>

                            <!-- Description -->
                            <TextBlock Text="Description"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>

                            <!-- Active Checkbox -->
                            <CheckBox Content="Active"
                                      IsChecked="{Binding CategoryIsActive}"
                                      Margin="0,0,0,15"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,15,0,0">
                                <Button Content="Save"
                                        Background="#3498DB"
                                        Foreground="White"
                                        Padding="15,8"
                                        Command="{Binding SaveCategoryCommand}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="Cancel"
                                        Background="#95A5A6"
                                        Foreground="White"
                                        Padding="15,8"
                                        Click="CancelCategoryForm_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Menu Image Form -->
                        <StackPanel Visibility="{Binding ShowMenuImageForm, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="Edit Menu Presentation Image"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="{Binding SelectedMenu.Name}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Menu Image URL"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding MenuImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Background="White"
                                     BorderBrush="#BDC3C7"
                                     Padding="10"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>

                            <Border Height="140"
                                    Background="#FFF3DF"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,0,15"
                                    Visibility="{Binding MenuImageUrl, Converter={StaticResource ObjectToVisibilityConverter}}">
                                <Image Source="{Binding MenuImageUrl}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Margin="8"/>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,15,0,0">
                                <Button Content="Save"
                                        Background="#27AE60"
                                        Foreground="White"
                                        Padding="15,8"
                                        Command="{Binding SaveMenuImageCommand}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="Cancel"
                                        Background="#95A5A6"
                                        Foreground="White"
                                        Padding="15,8"
                                        Click="CancelMenuImageForm_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Details Panel (no form) -->
                        <StackPanel Visibility="{Binding ShowProductForm, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <!-- Product Details -->
                            <StackPanel Visibility="{Binding SelectedProduct, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="Product Details"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="{Binding SelectedProduct.Name}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Category:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProduct.Category.Name}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Price:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProduct.Price, StringFormat='${0:F2}'}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Portion:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProduct.PortionQuantity, StringFormat='{}{0}g'}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Stock:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProduct.TotalQuantity, StringFormat='{}{0}g'}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,15">
                                    <TextBlock Text="Status:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedProduct.IsAvailable, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Available|Unavailable}"
                                               FontSize="12"/>
                                </StackPanel>

                                <TextBlock Text="Presentation Image URL:"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SelectedProductImageUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="#F8F9FA"
                                         BorderBrush="#E0E0E0"
                                         TextWrapping="Wrap"
                                         Padding="8"
                                         Margin="0,0,0,10"/>
                                <Border Height="120"
                                        Background="#FFF3DF"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,15"
                                        Visibility="{Binding HasSelectedProductImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding SelectedProductImageUrl}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="8"/>
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="✏️ Edit"
                                            Background="#3498DB"
                                            Foreground="White"
                                            Padding="12,8"
                                            Command="{Binding EditSelectedProductCommand}"/>
                                    <Button Content="🗑️ Delete"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            Padding="12,8"
                                            Command="{Binding DeleteSelectedProductCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Menu Details -->
                            <StackPanel Visibility="{Binding SelectedMenu, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="Menu Details"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="{Binding SelectedMenu.Name}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Category:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedMenu.Category.Name}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Bundle discount:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedMenu.BundleDiscountPercent, StringFormat='{}{0:F0}%'}"
                                               FontSize="12"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedMenu.Description}"
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Presentation Image URL:"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SelectedMenuImageUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="#F8F9FA"
                                         BorderBrush="#E0E0E0"
                                         TextWrapping="Wrap"
                                         Padding="8"
                                         Margin="0,0,0,10"/>
                                <Border Height="140"
                                        Background="#FFF3DF"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,15"
                                        Visibility="{Binding HasSelectedMenuImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding SelectedMenuImageUrl}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="8"/>
                                </Border>

                                <Button Content="Edit Menu Image"
                                        Background="#3498DB"
                                        Foreground="White"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding EditSelectedMenuImageCommand}"/>
                            </StackPanel>

                            <!-- Category Details -->
                            <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="Category Details"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="{Binding SelectedCategory.Name}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding SelectedCategory.Description}"
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,15">
                                    <TextBlock Text="Status:"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedCategory.IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter=Active|Inactive}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="✏️ Edit"
                                            Background="#3498DB"
                                            Foreground="White"
                                            Padding="12,8"
                                            Command="{Binding EditSelectedCategoryCommand}"/>
                                    <Button Content="🗑️ Delete"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            Padding="12,8"
                                            Command="{Binding DeleteSelectedCategoryCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Empty State -->
                            <TextBlock Text="Select a product or category to view details"
                                       FontSize="14"
                                       Foreground="#95A5A6"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SelectedProduct, Converter={StaticResource ObjectToVisibilityConverter}}"
                                       Margin="20"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Loading Indicator -->
        <Border Grid.Row="2"
                Background="#00000050"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Loading..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
