<UserControl x:Class="RestaurantOrderManagement.WPF.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
        d:DesignWidth="1000"
             Background="#FFF3DF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                Background="#D62300">
            <TextBlock Text="Order History"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#FFF3DF"/>
            <TextBlock Text="View and manage your orders"
                    FontSize="14"
                    Foreground="#FFE6C7"
                    Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filters and Actions -->
        <Grid Grid.Row="1"
                Background="#FFFDF7"
                Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Filter Label -->
            <TextBlock Text="Filter:"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#502314"
                    VerticalAlignment="Center"
                    Grid.Column="0"
                    Margin="0,0,10,0"/>

            <!-- Filter Buttons -->
            <Button Content="All Orders"
                    Background="#502314"
                    Foreground="#FFF3DF"
                    Padding="10,6"
                    Margin="0,0,5,0"
                    Grid.Column="1"
                    Command="{Binding SetStatusFilterCommand}"
                    CommandParameter="all"/>
            <Button Content="Active"
                    Background="#FFAA00"
                    Foreground="#502314"
                    Padding="10,6"
                    Margin="0,0,5,0"
                    Grid.Column="2"
                    Command="{Binding SetStatusFilterCommand}"
                    CommandParameter="active"/>
            <Button Content="Completed"
                    Background="#198754"
                    Foreground="#FFF3DF"
                    Padding="10,6"
                    Margin="0,0,5,0"
                    Grid.Column="3"
                    Command="{Binding SetStatusFilterCommand}"
                    CommandParameter="completed"/>
            <Button Content="Cancelled"
                    Background="#8A4B2A"
                    Foreground="#FFF3DF"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    Grid.Column="4"
                    Command="{Binding SetStatusFilterCommand}"
                    CommandParameter="cancelled"/>

            <!-- Refresh Button -->
            <Button Content="Refresh"
                    Background="#D62300"
                    Foreground="#FFF3DF"
                    Padding="15,6"
                    HorizontalAlignment="Right"
                    Grid.Column="5"
                    Command="{Binding LoadUserOrdersCommand}"/>
        </Grid>

        <!-- Orders List -->
        <Grid Grid.Row="2"
                Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Orders List Panel -->
            <ListBox Grid.Column="0"
                    ItemsSource="{Binding FilteredOrders}"
                    SelectedItem="{Binding SelectedOrder}"
                     Background="#FFFDF7"
                    BorderBrush="#F1C27D"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFDF7"
                                BorderBrush="#F1C27D"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="18">
                            <StackPanel>
                                <!-- Order Code -->
                                <TextBlock Text="{Binding OrderCode}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#502314"/>

                                <!-- Order Date -->
                                <TextBlock Text="{Binding OrderDate, StringFormat='Date: {0:g}'}"
                                        FontSize="11"
                                        Foreground="#8A4B2A"
                                        Margin="0,5,0,5"/>

                                <!-- Status -->
                                <Border Background="#FFE6C7"
                                        Padding="5,3"
                                        CornerRadius="10"
                                        Width="Auto"
                                        HorizontalAlignment="Left">
                                    <TextBlock FontSize="10"
                                            Foreground="#2C3E50"
                                            FontWeight="Bold">
                                        <Run Text="Status: "/>
                                        <Run Text="{Binding Status}"/>
                                    </TextBlock>
                                </Border>

                                <!-- Total -->
                                <TextBlock Text="{Binding TotalCost, StringFormat='Total: {0:C}'}"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#D62300"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Order Details Panel -->
            <ScrollViewer Grid.Column="1"
                    VerticalScrollBarVisibility="Auto"
                    Background="#FFFDF7">
                <StackPanel
                        Visibility="{Binding SelectedOrder, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <!-- Success Message -->
                    <Border Background="#D4EDDA"
                            BorderBrush="#28A745"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,15"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                FontSize="12"
                                Foreground="#155724"
                                TextWrapping="Wrap"/>
                    </Border>

                    <!-- Error Message -->
                    <Border Background="#F8D7DA"
                            BorderBrush="#DC3545"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,15"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                FontSize="12"
                                Foreground="#721C24"
                                TextWrapping="Wrap"/>
                    </Border>

                    <!-- Order Header -->
                    <TextBlock Text="{Binding SelectedOrder.OrderCode, StringFormat='Order: {0}'}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#502314"
                            Margin="0,0,0,15"/>

                    <!-- Order Details Grid -->
                    <Grid Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Order Date -->
                        <TextBlock Text="Order Date:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="0"
                                Grid.Column="0"/>
                        <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat='{}{0:g} }'}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="0"
                                Grid.Column="1"/>

                        <!-- Status -->
                        <TextBlock Text="Status:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding SelectedOrder.Status}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                FontWeight="Bold"/>

                        <!-- Delivery Address -->
                        <TextBlock Text="Address:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding SelectedOrder.DeliveryAddress}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                TextWrapping="Wrap"/>

                        <!-- Estimated Delivery -->
                        <TextBlock Text="Est. Delivery:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding SelectedOrder.EstimatedDeliveryTime, StringFormat='{}{0:g} }'}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,10,0,0"/>

                        <!-- Subtotal -->
                        <TextBlock Text="Subtotal:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,15,0,0"/>
                        <TextBlock Text="{Binding SelectedOrder.SubTotal, StringFormat='{}{0:C} }'}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,15,0,0"/>

                        <!-- Shipping Fee -->
                        <TextBlock Text="Shipping:"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8A4B2A"
                                Grid.Row="5"
                                Grid.Column="0"
                                Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding SelectedOrder.ShippingFee, StringFormat='{}{0:C} }'}"
                                FontSize="11"
                                Foreground="#502314"
                                Grid.Row="5"
                                Grid.Column="1"
                                Margin="0,5,0,0"/>

                        <!-- Total -->
                        <Rectangle Height="1" Fill="#F1C27D"
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,10"/>
                    </Grid>

                    <TextBlock Text="{Binding SelectedOrder.TotalCost, StringFormat='Total: {0:C}'}"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#D62300"
                            Margin="0,0,0,20"/>

                    <!-- Order Items -->
                    <TextBlock Text="Items:"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#502314"
                            Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SelectedOrder.OrderItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="#FFE6C7"
                                        Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#502314"/>
                                        <TextBlock Text="{Binding ItemType}"
                                                FontSize="10"
                                                Foreground="#8A4B2A"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                            FontSize="11"
                                            Foreground="#8A4B2A"
                                            Grid.Column="1"
                                            TextAlignment="Right"/>
                                    <TextBlock Text="{Binding ItemTotal, StringFormat='{}{0:C} }'}"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="#D62300"
                                            Grid.Column="2"
                                            TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Cancel Button -->
                    <Button Content="Cancel Order"
                            Background="#D62300"
                            Foreground="#FFF3DF"
                            Padding="15,10"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelOrderCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Visibility="{Binding SelectedOrder.Status, Converter={StaticResource StringEqualsConverter}, ConverterParameter=inregistrata}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading Indicator -->
        <TextBlock Grid.Row="2"
                Text="Loading orders..."
                FontSize="14"
                Foreground="#D62300"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Empty State -->
        <TextBlock Grid.Row="2"
                Text="No orders found. Start by placing an order!"
                FontSize="14"
                Foreground="#8A4B2A"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                   Visibility="{Binding UserOrders.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"/>
    </Grid>
</UserControl>
