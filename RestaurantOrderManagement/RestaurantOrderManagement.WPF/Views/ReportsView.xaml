<UserControl x:Class="RestaurantOrderManagement.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                Background="#2C3E50"
                Padding="20">
            <TextBlock Text="Business Reports"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"/>
            <TextBlock Text="Generate and export reports for orders, revenue, and inventory"
                    FontSize="14"
                    Foreground="#ECF0F1"
                    Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Date Range & Actions -->
        <StackPanel Grid.Row="1"
                Padding="20"
                Background="White"
                Margin="0,0,0,10">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- From Date -->
                <TextBlock Text="From Date:"
                        FontSize="12"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding ReportFromDate, UpdateSourceTrigger=PropertyChanged}"
                        Background="White"
                        BorderBrush="#BDC3C7"
                        Padding="8"
                        Grid.Column="1"/>

                <!-- To Date -->
                <TextBlock Text="To Date:"
                        FontSize="12"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Grid.Column="2"
                        Margin="20,0,10,0"/>
                <DatePicker SelectedDate="{Binding ReportToDate, UpdateSourceTrigger=PropertyChanged}"
                        Background="White"
                        BorderBrush="#BDC3C7"
                        Padding="8"
                        Grid.Column="3"/>
            </Grid>

            <!-- Report Generation Buttons -->
            <StackPanel Orientation="Horizontal"
                    Gap="10"
                    Margin="0,0,0,15">
                <Button Content="📊 Order Summary"
                        Background="#3498DB"
                        Foreground="White"
                        Padding="12,8"
                        Command="{Binding GenerateOrderSummaryCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="💰 Revenue Report"
                        Background="#27AE60"
                        Foreground="White"
                        Padding="12,8"
                        Command="{Binding GenerateRevenueSummaryCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="📦 Inventory Status"
                        Background="#E67E22"
                        Foreground="White"
                        Padding="12,8"
                        Command="{Binding GenerateInventorySummaryCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="📋 Order Details"
                        Background="#9B59B6"
                        Foreground="White"
                        Padding="12,8"
                        Command="{Binding GenerateOrderDetailsCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>

            <!-- Messages -->
            <Border Background="#D4EDDA"
                    BorderBrush="#28A745"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,10"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding SuccessMessage}"
                        FontSize="12"
                        Foreground="#155724"/>
            </Border>

            <Border Background="#F8D7DA"
                    BorderBrush="#DC3545"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                        FontSize="12"
                        Foreground="#721C24"
                        TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Reports TabControl -->
        <TabControl Grid.Row="2"
                SelectedIndex="{Binding SelectedReportTab}"
                Margin="10"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <!-- Tab 1: Order Summary -->
            <TabItem Header="Order Summary"
                    Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Summary Stats -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Gap="20"
                            Margin="0,0,0,15"
                            Padding="15"
                            Background="#ECF0F1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Total Orders"
                                    FontSize="12"
                                    Foreground="#7F8C8D"
                                    FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalOrdersCount, StringFormat='{0:N0}'}"
                                    FontSize="18"
                                    Foreground="#2C3E50"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Average Order Value"
                                    FontSize="12"
                                    Foreground="#7F8C8D"
                                    FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalOrdersAvgValue, StringFormat='${0:F2}'}"
                                    FontSize="18"
                                    Foreground="#2C3E50"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <Button Content="📥 Export to CSV"
                                    Background="#3498DB"
                                    Foreground="White"
                                    Padding="12,8"
                                    Command="{Binding ExportOrderSummaryToCsvCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Order Summary Table -->
                    <DataGrid Grid.Row="1"
                            ItemsSource="{Binding OrderSummaryData}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Background="White"
                            RowBackground="White"
                            AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="150"/>
                            <DataGridTextColumn Header="Order Count"
                                    Binding="{Binding OrderCount, StringFormat='N0'}"
                                    Width="120"/>
                            <DataGridTextColumn Header="Avg Value"
                                    Binding="{Binding AvgOrderValue, StringFormat='${0:F2}'}"
                                    Width="120"/>
                            <DataGridTextColumn Header="First Order"
                                    Binding="{Binding FirstOrder, StringFormat='yyyy-MM-dd'}"
                                    Width="150"/>
                            <DataGridTextColumn Header="Last Order"
                                    Binding="{Binding LastOrder, StringFormat='yyyy-MM-dd'}"
                                    Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Revenue Summary -->
            <TabItem Header="Revenue Report"
                    Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Revenue Stats -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Gap="20"
                            Margin="0,0,0,15"
                            Padding="15"
                            Background="#ECF0F1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Total Revenue"
                                    FontSize="12"
                                    Foreground="#7F8C8D"
                                    FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='${0:F2}'}"
                                    FontSize="18"
                                    Foreground="#27AE60"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Total Shipping"
                                    FontSize="12"
                                    Foreground="#7F8C8D"
                                    FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalShippingFee, StringFormat='${0:F2}'}"
                                    FontSize="18"
                                    Foreground="#2C3E50"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Total Discounts"
                                    FontSize="12"
                                    Foreground="#7F8C8D"
                                    FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalDiscount, StringFormat='${0:F2}'}"
                                    FontSize="18"
                                    Foreground="#E74C3C"
                                    FontWeight="Bold"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <Button Content="📥 Export to CSV"
                                    Background="#27AE60"
                                    Foreground="White"
                                    Padding="12,8"
                                    Command="{Binding ExportRevenueSummaryToCsvCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Revenue Summary Table -->
                    <DataGrid Grid.Row="1"
                            ItemsSource="{Binding RevenueSummaryData}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Background="White"
                            RowBackground="White"
                            AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="120"/>
                            <DataGridTextColumn Header="Orders"
                                    Binding="{Binding OrderCount, StringFormat='N0'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Subtotal"
                                    Binding="{Binding TotalSubtotal, StringFormat='${0:F2}'}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Shipping"
                                    Binding="{Binding TotalShipping, StringFormat='${0:F2}'}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Discount"
                                    Binding="{Binding TotalDiscount, StringFormat='${0:F2}'}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Total Revenue"
                                    Binding="{Binding TotalRevenue, StringFormat='${0:F2}'}"
                                    Width="120"/>
                            <DataGridTextColumn Header="Avg Order"
                                    Binding="{Binding AvgOrderTotal, StringFormat='${0:F2}'}"
                                    Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Inventory Summary -->
            <TabItem Header="Inventory Status"
                    Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Inventory Actions -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Gap="10"
                            Margin="0,0,0,15"
                            Padding="15"
                            Background="#ECF0F1"
                            CornerRadius="4"
                            HorizontalAlignment="Right">
                        <Button Content="📥 Export to CSV"
                                Background="#E67E22"
                                Foreground="White"
                                Padding="12,8"
                                Command="{Binding ExportInventorySummaryToCsvCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <!-- Inventory Table -->
                    <DataGrid Grid.Row="1"
                            ItemsSource="{Binding InventorySummaryData}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Background="White"
                            RowBackground="White"
                            AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category"
                                    Binding="{Binding CategoryName}"
                                    Width="150"/>
                            <DataGridTextColumn Header="Products"
                                    Binding="{Binding ProductCount, StringFormat='N0'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Total Stock"
                                    Binding="{Binding TotalStock, StringFormat='{0:N0}g'}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Avg Stock"
                                    Binding="{Binding AvgStockPerProduct, StringFormat='{0:N0}g'}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Min"
                                    Binding="{Binding MinStock, StringFormat='{0:N0}g'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Max"
                                    Binding="{Binding MaxStock, StringFormat='{0:N0}g'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Low Stock"
                                    Binding="{Binding LowStockCount, StringFormat='N0'}"
                                    Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: Order Details -->
            <TabItem Header="Order Details"
                    Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Order Details Actions -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Gap="10"
                            Margin="0,0,0,15"
                            Padding="15"
                            Background="#ECF0F1"
                            CornerRadius="4"
                            HorizontalAlignment="Right">
                        <Button Content="📥 Export to CSV"
                                Background="#9B59B6"
                                Foreground="White"
                                Padding="12,8"
                                Command="{Binding ExportOrderDetailsToCsvCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <!-- Order Details Table -->
                    <DataGrid Grid.Row="1"
                            ItemsSource="{Binding OrderDetailsData}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Background="White"
                            RowBackground="White"
                            AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order Code"
                                    Binding="{Binding OrderCode}"
                                    Width="100"/>
                            <DataGridTextColumn Header="Customer"
                                    Binding="{Binding CustomerName}"
                                    Width="150"/>
                            <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="180"/>
                            <DataGridTextColumn Header="Date"
                                    Binding="{Binding CreatedDate, StringFormat='yyyy-MM-dd HH:mm'}"
                                    Width="150"/>
                            <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="120"/>
                            <DataGridTextColumn Header="Subtotal"
                                    Binding="{Binding SubTotal, StringFormat='${0:F2}'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Shipping"
                                    Binding="{Binding ShippingFee, StringFormat='${0:F2}'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Discount"
                                    Binding="{Binding DiscountAmount, StringFormat='${0:F2}'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Total"
                                    Binding="{Binding Total, StringFormat='${0:F2}'}"
                                    Width="80"/>
                            <DataGridTextColumn Header="Items"
                                    Binding="{Binding ItemCount, StringFormat='N0'}"
                                    Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Loading Indicator -->
        <Border Grid.Row="2"
                Background="#00000050"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <TextBlock Text="Generating report..."
                        FontSize="16"
                        Foreground="White"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
