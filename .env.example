# Environment Configuration for Restaurant Order Management System
# Copy this file to .env and update with your values
# 
# Usage:
#   docker-compose --env-file .env up -d
#
# Or simply: docker-compose up -d (uses .env if present)

# ===================================================
# DATABASE CONFIGURATION
# ===================================================

# SQL Server database credentials
DATABASE_SERVER=sqlserver
DATABASE_PORT=1433
DATABASE_NAME=RestaurantOrderManagement
DATABASE_USERNAME=sa
DATABASE_PASSWORD=YourStrongPassword123!

# Use a strong password meeting SQL Server requirements:
# - At least 8 characters
# - Contains uppercase, lowercase, digits, and special characters
# - Example: Str0ng!Pwd@2024

# ===================================================
# APPLICATION CONFIGURATION
# ===================================================

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# Valid values: Production, Staging, Development
# Production: Optimized, minimal logging
# Staging: Enhanced logging, debugging enabled
# Development: Full diagnostics

# ===================================================
# DATA PERSISTENCE
# ===================================================

# Base path for Docker volumes (persistent storage)
# Leave empty to use default: ./docker-volumes/
DATA_PATH=./docker-volumes/

# ===================================================
# OPTIONAL: Container Resource Limits
# ===================================================

# Uncomment to set resource limits (requires docker-compose v3.9+)
# MEMORY_LIMIT=2g
# CPUS_LIMIT=2

# ===================================================
# OPTIONAL: Logging Configuration
# ===================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output destination: console, file, both
LOG_OUTPUT=both

# ===================================================
# NOTES
# ===================================================
# 
# 1. Database initialization:
#    - Tables are created from Database/02_CreateTables.sql
#    - Stored procedures from Database/03_CreateStoredProcedures.sql
#    - Indexes from Database/04_CreateIndexes.sql
# 
# 2. First run:
#    - docker-compose up -d
#    - Wait for SQL Server to be ready (check logs)
#    - Run database initialization scripts (optional, may need manual execution)
# 
# 3. Accessing the database:
#    - From host: Server=localhost,1433; User=sa; Password=...
#    - From containers: Server=sqlserver,1433; User=sa; Password=...
# 
# 4. Container networking:
#    - Services communicate via service names (e.g., 'sqlserver')
#    - Use 'restaurant-network' bridge network
# 
# 5. Data persistence:
#    - All data persists in docker-volumes/ directory
#    - Volumes survive container restarts
#    - Delete docker-volumes/ to reset (destructive!)
#
